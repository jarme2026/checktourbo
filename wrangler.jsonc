{
  "name": "checktourbo",
  "compatibility_date": "2026-07-15",
  "main": "src/index.js",
  "vars": {
    "REPORT_RECIPIENTS": "jarme@boconcept.com"
  },
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "07fda41a4c7444849daa3e4232849687",
      "secret_name": "resend-api-key"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHECKLIST", "class_name": "ChecklistState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChecklistState"] }
  ]
}
